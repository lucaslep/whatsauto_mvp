# Copie para .env. Nunca publique .env nem seus tokens.
# Modo de conexão: 'qr' (WhatsApp Web via QR Code, sem conta Meta) ou 'meta' (API Oficial da Meta)
CONNECTION_MODE=qr
QR_BRIDGE_URL=http://127.0.0.1:5001

# Configurações para API Oficial da Meta (usadas apenas se CONNECTION_MODE=meta)
META_VERIFY_TOKEN=whatsauto-verify-token-empresa
META_APP_SECRET=cole-o-app-secret-da-meta
WHATSAPP_ACCESS_TOKEN=cole-o-token-da-cloud-api
WHATSAPP_PHONE_NUMBER_ID=cole-o-phone-number-id
GRAPH_API_VERSION=v23.0

# Token de segurança entre o painel e o servidor local
ADMIN_TOKEN=whatsauto-token-admin-local
DATABASE_PATH=whatsauto.db

# Tempo mínimo (em minutos) para não repetir a mesma resposta automática para o mesmo cliente
COOLDOWN_MINUTES=30

# Identificação exibida no topo de toda mensagem enviada pelo robô (use * para negrito no WhatsApp)
BOT_PREFIX=🤖 *Atendimento Automático (Robô):*

# Se true, apenas simula e não envia mensagens reais no WhatsApp (pode ser alterado pelo painel)
SIMULATION_MODE=false
